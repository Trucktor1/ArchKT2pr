@startuml
class СправочникТоваров {
  - ID: int
  - Наименование: string
  - Цена: decimal
  + Добавить()
  + Удалить()
}

class СправочникКонтрагентов {
  - ID: int
  - Наименование: string
  - ИНН: string
}

class ДокументЗакупки {
  - ID: int
  - Номер: string
  - Дата: DateTime
  - Сумма: decimal
  + Провести()
  + Экспорт()
}

class СтрокаЗакупки {
  - Количество: decimal
  - Цена: decimal
  + РассчитатьСумму()
}

class СервисОшибок {
  + Зафиксировать()
  + ПроверитьЦелостность()
}

ДокументЗакупки "1" --> "1..*" СтрокаЗакупки
СтрокаЗакупки --> СправочникТоваров
ДокументЗакупки --> СправочникКонтрагентов
ДокументЗакупки ..> СервисОшибок
@enduml